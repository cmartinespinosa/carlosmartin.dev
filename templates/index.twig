{% set homepage = craft.entries().section('homepage').one() %}
{% set metaTitle = 'Carlos Martin | ' ~ (homepage.heroTitle ?? 'Full-Stack Developer') %}
{% set metaDesc = homepage.heroSubtitle ?? 'Full-stack developer with 15+ years of experience building scalable applications.' %}
{% set metaImage = 'https://www.carlosmartin.dev/og-image.png' %}
{% set canonicalUrl = siteUrl('/') %}
<!DOCTYPE html>
<html lang="en" id="top">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDesc }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDesc }}">
  <meta property="og:image" content="{{ metaImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:site_name" content="Carlos Martin">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ metaTitle }}">
  <meta name="twitter:description" content="{{ metaDesc }}">
  <meta name="twitter:image" content="{{ metaImage }}">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23F97316'/><text x='16' y='21' text-anchor='middle' fill='white' font-size='14' font-weight='bold' font-family='Arial,sans-serif'>CM</text></svg>">
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Carlos Martin",
    "jobTitle": "{{ homepage.heroTitle ?? 'Full-Stack Developer' }}",
    "url": "{{ canonicalUrl }}",
    "description": "{{ metaDesc }}",
    "image": "{{ metaImage }}",
    "sameAs": [
      "https://github.com/cmartinespinosa",
      "https://www.linkedin.com/in/carlosmartin0310/"
    ]
  }
  </script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#FFF7ED', 100: '#FFEDD5', 200: '#FED7AA',
              300: '#FDBA74', 400: '#FB923C', 500: '#F97316',
              600: '#EA580C', 700: '#C2410C', 800: '#9A3412', 900: '#7C2D12',
            }
          },
          fontFamily: { sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'] },
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    html { scroll-behavior: smooth; overflow-x: hidden; }
    body { overflow-x: hidden; }
    .skill-card { transition: all .3s ease; }
    .skill-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0,0,0,.1); }
    .timeline-line { position: absolute; left: 50%; transform: translateX(-50%); top: 0; bottom: 0; width: 2px; background: #FED7AA; }
    @media (max-width: 767px) { .timeline-line { left: 20px; } }
    [x-cloak] { display: none !important; }
    .tech-badge { transition: all .2s ease; }
    .tech-badge:hover { transform: translateY(-3px); }
    .tech-badge:hover { transform: translateY(-3px); }
    .gameboy-overlay { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    .gameboy-shell { background: #D4C9A8; border-radius: 20px; }
    #tetris-game { image-rendering: pixelated; }
    #tetris-game:focus { outline: none; }
    #tetris-next { image-rendering: pixelated; }
  </style>
</head>
<body class="bg-white text-gray-800 antialiased">

  {% set skillCards = craft.entries().section('skillCards').orderBy('title asc').all() %}
  {% set experience = craft.entries().section('experience').orderBy('postDate desc').all() %}
  {% set socialLinks = craft.entries().section('socialLinks').all() %}

  {% set heroTitle = homepage.heroTitle ?? 'Full-Stack Developer' %}
  {% set heroSubtitle = homepage.heroSubtitle ?? 'I design and code beautifully simple things, and I love what I do.' %}
  {% set aboutHeading = homepage.aboutHeading ?? "Hi, I'm Carlos. Nice to meet you." %}
  {% set aboutContent = homepage.aboutContent ?? 'Full-stack developer with 15+ years of experience.' %}
  {% set footerTagline = homepage.footerTagline ?? 'Living, learning, & leveling up one day at a time.' %}

  <!-- ========== NAV ========== -->
  <nav x-data="{ open: false }" class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-sm border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-5">
      <div class="flex items-center justify-between h-16">
        <a href="#top" class="flex items-center gap-2 text-primary-500 font-bold text-xl">
          <span class="w-8 h-8 bg-primary-500 rounded-lg flex items-center justify-center text-white text-sm font-bold">CM</span>
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href="#experience" class="text-gray-600 hover:text-primary-500 transition text-sm font-medium">Experience</a>
          <a href="#about" class="text-gray-600 hover:text-primary-500 transition text-sm font-medium">About</a>
          <a href="#stack" class="text-gray-600 hover:text-primary-500 transition text-sm font-medium">Stack</a>
          <a href="#contact" class="inline-block bg-primary-500 hover:bg-primary-600 text-white px-5 py-2 rounded-full text-sm font-medium transition">Say Hello</a>
        </div>
        <button @click="open = !open" class="md:hidden text-gray-600 text-2xl">
          <i :class="open ? 'fas fa-times' : 'fas fa-bars'"></i>
        </button>
      </div>
    </div>
    <div x-cloak x-show="open" x-transition class="md:hidden bg-white border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-5 py-4 flex flex-col gap-4">
        <a @click="open = false" href="#experience" class="text-gray-600 hover:text-primary-500 transition text-sm font-medium">Experience</a>
        <a @click="open = false" href="#about" class="text-gray-600 hover:text-primary-500 transition text-sm font-medium">About</a>
        <a @click="open = false" href="#stack" class="text-gray-600 hover:text-primary-500 transition text-sm font-medium">Stack</a>
        <a @click="open = false" href="#contact" class="inline-block bg-primary-500 hover:bg-primary-600 text-white px-5 py-2 rounded-full text-sm font-medium transition text-center">Say Hello</a>
      </div>
    </div>
  </nav>

  <!-- ========== HERO ========== -->
  <section class="relative pt-28 pb-16 md:pt-36 md:pb-24 text-center overflow-hidden">
    <canvas id="tetris-bg" class="absolute inset-0 w-full h-full pointer-events-none" style="opacity: .45;"></canvas>
    <div class="relative max-w-4xl mx-auto px-5">
      <div class="mb-6">
        <img src="/images/carlos.jpg" alt="Carlos Martin" class="w-32 h-32 md:w-40 md:h-40 rounded-full object-cover mx-auto shadow-lg ring-4 ring-primary-200">
      </div>
      <div class="mb-8">
        <span class="inline-flex items-center gap-2 bg-primary-100 text-primary-700 text-xs font-semibold px-4 py-1.5 rounded-full">
          <i class="fa-solid fa-location-dot text-primary-500"></i> Zürich, Switzerland
        </span>
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-5">{{ heroTitle }}</h1>
      <p class="text-lg md:text-xl text-gray-500 max-w-2xl mx-auto mb-12">{{ heroSubtitle }}</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#experience" class="inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-white rounded-full px-6 py-3 text-sm font-medium transition">
          See my work <i class="fa-solid fa-arrow-down text-xs"></i>
        </a>
        <a href="#contact" class="inline-flex items-center gap-2 text-gray-600 hover:text-primary-500 border border-gray-300 hover:border-primary-500 rounded-full px-6 py-3 text-sm font-medium transition">
          <i class="fa-regular fa-message"></i> Get in touch
        </a>
      </div>
    </div>
    <button onclick="openTetris()" class="absolute bottom-4 right-4 z-10 inline-flex items-center gap-2 bg-white/80 hover:bg-white border border-gray-200 text-gray-600 hover:text-primary-500 rounded-full px-4 py-2 text-xs font-medium shadow-sm transition backdrop-blur-sm">
      <i class="fa-solid fa-play text-primary-500"></i> Play
    </button>
  </section>

  <!-- ========== ABOUT ========== -->
  <section id="about" class="py-20 md:py-28 text-center" style="background-color: #FFF7ED;">
    <div class="max-w-3xl mx-auto px-5">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">{{ aboutHeading }}</h2>
      <p class="text-base md:text-lg text-gray-600 leading-relaxed">{{ aboutContent }}</p>
    </div>
  </section>

  <!-- ========== SKILLS ========== -->
  <section class="py-8 md:py-4">
    <div class="max-w-5xl mx-auto px-5">
      <div class="relative -mt-12">
        <div class="grid md:grid-cols-3 gap-6">
          {% for card in skillCards %}
          <div class="skill-card bg-white rounded-xl shadow-lg p-8 text-center border border-gray-100">
            <div class="w-14 h-14 rounded-full bg-primary-100 flex items-center justify-center mx-auto mb-5">
              <i class="{{ card.iconClass }} text-primary-500 text-xl"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">{{ card.title }}</h3>
            <p class="text-gray-500 text-sm mb-6">{{ card.shortDescription }}</p>
            <p class="text-primary-500 font-semibold text-xs uppercase tracking-wider mb-2">{{ card.languagesTitle }}</p>
            <p class="text-gray-600 text-sm mb-5">{{ card.languagesText }}</p>
            <p class="text-primary-500 font-semibold text-xs uppercase tracking-wider mb-2">{{ card.toolsTitle }}</p>
            <ul class="text-gray-600 text-sm space-y-1">
              {% for tool in card.toolsList|split('\n') %}
              <li>{{ tool }}</li>
              {% endfor %}
            </ul>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- ========== STACK & TOOLS ========== -->
  <section id="stack" class="py-20 md:py-28 text-center" style="background-color: #FFF7ED;">
    <div class="max-w-5xl mx-auto px-5">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Stack & Tools</h2>
      <p class="text-gray-500 max-w-2xl mx-auto mb-12">The technologies I work with day to day.</p>
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-5">
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-react text-3xl text-[#61DAFB]"></i>
          <span class="text-xs font-semibold text-gray-700">React</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-vuejs text-3xl text-[#4FC08D]"></i>
          <span class="text-xs font-semibold text-gray-700">Vue</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-js text-3xl text-[#F7DF1E]"></i>
          <span class="text-xs font-semibold text-gray-700">JavaScript</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-html5 text-3xl text-[#E34F26]"></i>
          <span class="text-xs font-semibold text-gray-700">HTML5</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-css3-alt text-3xl text-[#1572B6]"></i>
          <span class="text-xs font-semibold text-gray-700">CSS3</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-laravel text-3xl text-[#FF2D20]"></i>
          <span class="text-xs font-semibold text-gray-700">Laravel</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-php text-3xl text-[#777BB4]"></i>
          <span class="text-xs font-semibold text-gray-700">PHP</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-node-js text-3xl text-[#339933]"></i>
          <span class="text-xs font-semibold text-gray-700">Node.js</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-docker text-3xl text-[#2496ED]"></i>
          <span class="text-xs font-semibold text-gray-700">Docker</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <i class="fa-brands fa-git-alt text-3xl text-[#F05032]"></i>
          <span class="text-xs font-semibold text-gray-700">Git</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <div class="w-9 h-9 rounded-lg bg-[#38BDF8] flex items-center justify-center text-white text-[10px] font-bold leading-tight p-1">TW</div>
          <span class="text-xs font-semibold text-gray-700">Tailwind</span>
        </div>
        <div class="tech-badge bg-white rounded-xl p-5 shadow-sm border border-gray-100 flex flex-col items-center gap-2">
          <div class="w-9 h-9 rounded-lg bg-[#2E3440] flex items-center justify-center text-white text-[10px] font-bold">A</div>
          <span class="text-xs font-semibold text-gray-700">Alpine.js</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== EXPERIENCE ========== -->
  <section id="experience" class="py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-5">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 text-center mb-4">Professional Experience</h2>
      <p class="text-gray-500 text-center max-w-2xl mx-auto mb-16">My career path so far.</p>
      <div class="relative">
        <div class="timeline-line"></div>
        <div class="space-y-12">
          {% for job in experience %}
          <div class="relative flex flex-col md:flex-row items-start gap-6">
            <div class="hidden md:flex w-1/2 justify-end pr-8 pt-1">
              <div class="text-right">
                <span class="inline-block bg-primary-100 text-primary-700 text-xs font-semibold px-3 py-1 rounded-full">{{ job.period }}</span>
              </div>
            </div>
            <div class="absolute left-[11px] md:left-1/2 md:-translate-x-1/2 top-1 w-4 h-4 rounded-full bg-primary-500 border-4 border-primary-100 z-10"></div>
            <div class="relative w-[calc(100%-2rem)] md:w-[calc(50%-2rem)] bg-white rounded-xl p-6 shadow-md border border-gray-100 md:ml-0 ml-8">
              <div class="md:hidden mb-3">
                <span class="inline-block bg-primary-100 text-primary-700 text-xs font-semibold px-3 py-1 rounded-full">{{ job.period }}</span>
              </div>
              <div class="flex items-start justify-between gap-4 mb-3">
                <div>
                  <h3 class="text-lg font-bold text-gray-900">{{ job.company }}</h3>
                  <p class="text-primary-500 font-medium text-sm">{{ job.role }}</p>
                </div>
              </div>
              <div class="flex items-center gap-3 text-xs text-gray-400 mb-4">
                <span><i class="fa-regular fa-calendar mr-1"></i> {{ job.period }}</span>
                <span><i class="fa-solid fa-location-dot mr-1"></i> {{ job.location }}</span>
              </div>
              <div class="text-gray-600 text-sm leading-relaxed space-y-1">
                {% for line in job.expDescription|split('\n') %}
                <p>{{ line }}</p>
                {% endfor %}
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- ========== CONTACT CTA ========== -->
  <section id="contact" class="py-16" style="background-color: #FFF7ED;">
    <div class="max-w-4xl mx-auto px-5">
      <div class="bg-white rounded-2xl shadow-lg p-8 md:p-12">
        <div class="md:flex items-center justify-between gap-8 text-center md:text-left">
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">Let's work together</h3>
            <p class="text-gray-500 text-sm">Got a project or idea? I'd love to hear about it.</p>
          </div>
          <div class="mt-6 md:mt-0 shrink-0">
            <a href="mailto:cmartinespinosa@gmail.com" class="inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-white rounded-full px-6 py-3 text-sm font-medium transition">
              <i class="fa-regular fa-hand-peace"></i> Let's do this
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FOOTER ========== -->
  <footer class="py-16 text-center" style="background-color: #FFF7ED;">
    <div class="max-w-md mx-auto px-5">
      <span class="w-12 h-12 bg-primary-500 rounded-xl flex items-center justify-center text-white text-lg font-bold mx-auto mb-6">CM</span>
      <p class="text-gray-600 text-sm mb-8 leading-relaxed">{{ footerTagline }}</p>
      <div class="flex justify-center gap-3 mb-8">
        {% for link in socialLinks %}
        <a href="{{ link.socialUrl }}" target="_blank" class="w-10 h-10 bg-white hover:bg-primary-500 text-gray-600 hover:text-white rounded-full flex items-center justify-center transition shadow-sm border border-gray-200">
          <i class="{{ link.socialIconClass }}"></i>
        </a>
        {% endfor %}
      </div>
      <p class="text-gray-400 text-xs">
        Handcrafted by me <i class="far fa-copyright"></i> {{ now|date('Y') }}
      </p>
    </div>
  </footer>

  <!-- TETRIS GAME OVERLAY -->
  <div id="tetris-overlay" class="fixed inset-0 z-[100] flex items-center justify-center hidden bg-black/50 gameboy-overlay">
    <div class="gameboy-shell shadow-2xl p-6 pt-8 relative" style="width: 340px;">
      <button onclick="closeTetris()" class="absolute top-2 right-3 text-[#8B7E6A] hover:text-[#5C4F3E] text-lg transition z-10">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <div class="text-center font-bold text-sm tracking-[.3em] text-[#5C4F3E] mb-3 select-none">TETRIS</div>
      <div class="bg-[#8BAC0F] rounded-md p-2 border-2 border-[#5C6B2C] mb-4">
        <canvas id="tetris-game" class="mx-auto" tabindex="0"></canvas>
      </div>
      <div class="flex justify-between items-center mb-4">
        <div class="flex gap-4 text-xs font-mono text-[#5C4F3E]">
          <div>Score <span id="game-score" class="font-bold">0</span></div>
          <div>Lines <span id="game-lines" class="font-bold">0</span></div>
          <div>Lvl <span id="game-level" class="font-bold">1</span></div>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono text-[#5C4F3E]">Next</span>
          <canvas id="tetris-next" width="72" height="56" class="bg-[#8BAC0F] rounded border border-[#5C6B2C]"></canvas>
        </div>
      </div>
      <div id="game-controls-hint" class="text-center text-[10px] text-[#8B7E6A] font-mono mb-3 select-none">← → ↓ rotate↑ space↘</div>
      <div class="flex gap-2">
        <button onclick="startGame()" class="flex-1 py-2.5 bg-[#5C4F3E] hover:bg-[#3D3224] text-[#D4C9A8] rounded-lg text-sm font-bold tracking-wider transition">
          START
        </button>
      </div>
      <div class="mt-3 text-center">
        <button id="music-btn" onclick="toggleMusic()" class="w-full py-2 bg-[#8B7E6A] hover:bg-[#5C4F3E] text-[#D4C9A8] rounded-lg text-xs font-bold tracking-wider transition inline-flex items-center justify-center gap-2">
          <i class="fa-solid fa-volume-xmark"></i> Music
        </button>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // Tetris background animation
    (function() {
      var canvas = document.getElementById('tetris-bg');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var layers = [
        { block: 14, speed: 0.2, alpha: 0.15, interval: [3500, 2500] },
        { block: 24, speed: 0.45, alpha: 0.25, interval: [2500, 2000] },
        { block: 38, speed: 0.8, alpha: 0.35, interval: [1800, 1500] },
      ];
      var pieces = [
        // I
        { shape: [[1,1,1,1]], color: '#00F0F0' },
        { shape: [[1],[1],[1],[1]], color: '#00F0F0' },
        // O
        { shape: [[1,1],[1,1]], color: '#F0F000' },
        // T
        { shape: [[1,1,1],[0,1,0]], color: '#A000F0' },
        { shape: [[0,1],[1,1],[0,1]], color: '#A000F0' },
        // L
        { shape: [[1,1,1],[1,0,0]], color: '#F0A000' },
        { shape: [[1,1],[0,1],[0,1]], color: '#F0A000' },
        { shape: [[0,0,1],[1,1,1]], color: '#F0A000' },
        // J
        { shape: [[1,1,1],[0,0,1]], color: '#0000F0' },
        { shape: [[0,1],[0,1],[1,1]], color: '#0000F0' },
        { shape: [[1,0,0],[1,1,1]], color: '#0000F0' },
        // S
        { shape: [[1,1,0],[0,1,1]], color: '#00F000' },
        { shape: [[0,1],[1,1],[1,0]], color: '#00F000' },
        // Z
        { shape: [[0,1,1],[1,1,0]], color: '#F00000' },
        { shape: [[1,0],[1,1],[0,1]], color: '#F00000' },
      ];
      var falling = [];

      function resize() {
        var rect = canvas.parentElement.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
      }

      function addPiece(layerIdx) {
        var l = layers[layerIdx];
        var p = pieces[Math.floor(Math.random() * pieces.length)];
        var pw = p.shape[0].length * l.block;
        var ph = p.shape.length * l.block;
        var mx, attempts = 0;
        do {
          mx = Math.random() * (canvas.width + pw * 2) - pw;
          attempts++;
        } while (attempts < 15 && falling.some(function(f) {
          var fl = layers[f.layer];
          var fw = f.shape[0].length * fl.block;
          var fh = f.shape.length * fl.block;
          return Math.abs(f.x - mx) < (fw + pw) / 2 && f.y < ph + 20;
        }));
        falling.push({
          x: mx,
          y: -ph * (1 + Math.random()),
          shape: p.shape,
          color: p.color,
          layer: layerIdx
        });
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (var i = 0; i < falling.length; i++) {
          var p = falling[i];
          var l = layers[p.layer];
          var drawn = false;
          for (var r = 0; r < p.shape.length; r++) {
            for (var c = 0; c < p.shape[r].length; c++) {
              if (p.shape[r][c]) {
                drawn = true;
                var x = p.x + c * l.block, y = p.y + r * l.block;
                ctx.fillStyle = p.color;
                ctx.globalAlpha = l.alpha;
                ctx.fillRect(x, y, l.block - 1, l.block - 1);
                ctx.globalAlpha = l.alpha + 0.15;
                ctx.strokeStyle = p.color;
                ctx.lineWidth = Math.max(0.5, l.block / 28);
                ctx.strokeRect(x, y, l.block - 1, l.block - 1);
              }
            }
          }
          p.y += l.speed;
          if (!drawn || p.y > canvas.height + l.block * 2) { falling.splice(i, 1); i--; }
        }
        ctx.globalAlpha = 1;
      }

      var timers = [0, 0, 0];
      function loop(time) {
        for (var i = 0; i < 3; i++) {
          if (time - timers[i] > layers[i].interval[0] + Math.random() * layers[i].interval[1]) {
            addPiece(i);
            timers[i] = time;
          }
        }
        draw();
        requestAnimationFrame(loop);
      }

      resize();
      window.addEventListener('resize', resize);
      // Spawn initial pieces already visible mid-canvas
      for (var i = 0; i < 3; i++) {
        var l = layers[i];
        for (var j = 0; j < 4; j++) {
          var p = pieces[Math.floor(Math.random() * pieces.length)];
          var pw = p.shape[0].length * l.block;
          var ph = p.shape.length * l.block;
          falling.push({
            x: Math.random() * (canvas.width + pw * 2) - pw,
            y: Math.random() * canvas.height * 0.8,
            shape: p.shape,
            color: p.color,
            layer: i
          });
        }
      }
      requestAnimationFrame(loop);
    })();

    // === TETRIS GAME ===
    (function() {
      var canvas = document.getElementById('tetris-game');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var previewCanvas = document.getElementById('tetris-next');
      var previewCtx = previewCanvas ? previewCanvas.getContext('2d') : null;
      var COLS = 10, ROWS = 20, SIZE = 20;
      canvas.width = COLS * SIZE;
      canvas.height = ROWS * SIZE;

      var PIECES = [
        { shape: [[1,1,1,1]], color: '#00F0F0' },
        { shape: [[1,1],[1,1]], color: '#F0F000' },
        { shape: [[0,1,0],[1,1,1]], color: '#A000F0' },
        { shape: [[1,0,0],[1,1,1]], color: '#F0A000' },
        { shape: [[0,0,1],[1,1,1]], color: '#0000F0' },
        { shape: [[0,1,1],[1,1,0]], color: '#00F000' },
        { shape: [[1,1,0],[0,1,1]], color: '#F00000' },
      ];
      var COLORS = ['#00F0F0','#F0F000','#A000F0','#F0A000','#0000F0','#00F000','#F00000'];
      var grid = [], gameOver = false, score = 0, lines = 0, level = 1;
      var currentPiece, currentType, currentX, currentY, nextType;
      var dropTimer = null;

      function createGrid() {
        for (var r = 0; r < ROWS; r++) {
          grid[r] = [];
          for (var c = 0; c < COLS; c++) grid[r][c] = 0;
        }
      }

      function rotate(m) {
        var rows = m.length, cols = m[0].length, r = [];
        for (var c = 0; c < cols; c++) {
          r[c] = [];
          for (var i = rows - 1; i >= 0; i--) r[c].push(m[i][c]);
        }
        return r;
      }

      function valid(shape, x, y) {
        for (var r = 0; r < shape.length; r++)
          for (var c = 0; c < shape[r].length; c++)
            if (shape[r][c]) {
              var nx = x + c, ny = y + r;
              if (nx < 0 || nx >= COLS || ny >= ROWS) return false;
              if (ny >= 0 && grid[ny][nx] !== 0) return false;
            }
        return true;
      }

      var audioCtx = null;
      function getAudioCtx() {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        return audioCtx;
      }
      function playLandSound() {
        try {
          var ctx = getAudioCtx();
          var osc = ctx.createOscillator();
          var gain = ctx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(120, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(60, ctx.currentTime + 0.08);
          gain.gain.setValueAtTime(0.3, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.1);
          osc.connect(gain); gain.connect(ctx.destination);
          osc.start(ctx.currentTime); osc.stop(ctx.currentTime + 0.1);
        } catch(e) {}
      }
      function playClearSound() {
        try {
          var ctx = getAudioCtx();
          var notes = [523, 659, 784];
          notes.forEach(function(freq, i) {
            var osc = ctx.createOscillator();
            var gain = ctx.createGain();
            osc.type = 'square';
            osc.frequency.setValueAtTime(freq, ctx.currentTime + i * 0.08);
            gain.gain.setValueAtTime(0.2, ctx.currentTime + i * 0.08);
            gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + i * 0.08 + 0.12);
            osc.connect(gain); gain.connect(ctx.destination);
            osc.start(ctx.currentTime + i * 0.08); osc.stop(ctx.currentTime + i * 0.08 + 0.12);
          });
        } catch(e) {}
      }

      function lock() {
        for (var r = 0; r < currentPiece.length; r++)
          for (var c = 0; c < currentPiece[r].length; c++)
            if (currentPiece[r][c]) {
              var ny = currentY + r, nx = currentX + c;
              if (ny < 0) { gameOver = true; return; }
              grid[ny][nx] = currentType + 1;
            }
        playLandSound();
        clearLines();
        spawn();
      }

      function clearLines() {
        var cleared = 0;
        for (var r = ROWS - 1; r >= 0; r--) {
          var full = true;
          for (var c = 0; c < COLS; c++) if (grid[r][c] === 0) { full = false; break; }
          if (full) {
            grid.splice(r, 1);
            grid.unshift(new Array(COLS).fill(0));
            cleared++; r++;
          }
        }
        if (cleared) {
          playClearSound();
          var pts = [0, 100, 300, 500, 800];
          score += (pts[cleared] || 800) * level;
          lines += cleared;
          level = Math.floor(lines / 10) + 1;
          updateInfo();
          // Increase speed
          if (dropTimer) {
            clearInterval(dropTimer);
            dropTimer = setInterval(tick, Math.max(100, 400 - (level - 1) * 30));
          }
        }
      }

      function spawn() {
        currentType = nextType;
        nextType = Math.floor(Math.random() * PIECES.length);
        currentPiece = PIECES[currentType].shape;
        currentX = Math.floor((COLS - currentPiece[0].length) / 2);
        currentY = -1;
        if (!valid(currentPiece, currentX, currentY)) gameOver = true;
        drawNext();
      }

      function tick() {
        if (!gameOver) {
          if (valid(currentPiece, currentX, currentY + 1)) currentY++;
          else lock();
        }
        draw();
      }

      function moveLeft() { if (!gameOver && valid(currentPiece, currentX - 1, currentY)) currentX--; draw(); }
      function moveRight() { if (!gameOver && valid(currentPiece, currentX + 1, currentY)) currentX++; draw(); }
      function moveDown() { if (!gameOver && valid(currentPiece, currentX, currentY + 1)) currentY++; draw(); }
      function rotatePiece() {
        if (gameOver) return;
        var r = rotate(currentPiece);
        if (valid(r, currentX, currentY)) currentPiece = r;
        draw();
      }
      function hardDrop() {
        if (gameOver) return;
        while (valid(currentPiece, currentX, currentY + 1)) currentY++;
        lock(); draw();
      }

      function draw() {
        ctx.fillStyle = '#8BAC0F';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        for (var r = 0; r < ROWS; r++)
          for (var c = 0; c < COLS; c++) {
            if (grid[r][c] !== 0) {
              ctx.fillStyle = COLORS[grid[r][c] - 1];
              ctx.fillRect(c * SIZE, r * SIZE, SIZE - 1, SIZE - 1);
            } else {
              ctx.fillStyle = 'rgba(0,0,0,.06)';
              ctx.fillRect(c * SIZE, r * SIZE, SIZE - 1, SIZE - 1);
            }
          }
        if (!gameOver && currentPiece)
          for (var r = 0; r < currentPiece.length; r++)
            for (var c = 0; c < currentPiece[r].length; c++)
              if (currentPiece[r][c]) {
                var x = (currentX + c) * SIZE, y = (currentY + r) * SIZE;
                ctx.fillStyle = COLORS[currentType];
                ctx.fillRect(x, y, SIZE - 1, SIZE - 1);
              }
        if (gameOver) {
          ctx.fillStyle = 'rgba(0,0,0,.65)';
          ctx.fillRect(0, ROWS / 2 * SIZE - 18, COLS * SIZE, 36);
          ctx.fillStyle = '#fff';
          ctx.font = 'bold 14px monospace';
          ctx.textAlign = 'center';
          ctx.fillText('GAME OVER', COLS * SIZE / 2, ROWS / 2 * SIZE + 5);
        }
      }

      function drawNext() {
        if (!previewCtx) return;
        previewCtx.fillStyle = '#8BAC0F';
        previewCtx.fillRect(0, 0, previewCanvas.width, previewCanvas.height);
        var shape = PIECES[nextType].shape, ps = 16;
        var ox = (previewCanvas.width - shape[0].length * ps) / 2;
        var oy = (previewCanvas.height - shape.length * ps) / 2;
        previewCtx.fillStyle = COLORS[nextType];
        for (var r = 0; r < shape.length; r++)
          for (var c = 0; c < shape[r].length; c++)
            if (shape[r][c]) previewCtx.fillRect(ox + c * ps, oy + r * ps, ps - 1, ps - 1);
      }

      function updateInfo() {
        document.getElementById('game-score').textContent = score;
        document.getElementById('game-lines').textContent = lines;
        document.getElementById('game-level').textContent = level;
      }

      window.startGame = function() {
        createGrid();
        score = 0; lines = 0; level = 1; gameOver = false;
        nextType = Math.floor(Math.random() * PIECES.length);
        spawn();
        updateInfo();
        if (dropTimer) clearInterval(dropTimer);
        dropTimer = setInterval(tick, 400);
        draw();
      };

      window.openTetris = function() {
        document.getElementById('tetris-overlay').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        canvas.focus();
        startGame();
      };

      window.closeTetris = function() {
        document.getElementById('tetris-overlay').classList.add('hidden');
        document.body.style.overflow = '';
        if (dropTimer) { clearInterval(dropTimer); dropTimer = null; }
      };

      var hint = document.getElementById('game-controls-hint');
      if ('ontouchstart' in window || navigator.maxTouchPoints > 0) {
        hint.textContent = '← → swipe · ↓ swipe · tap rotate · space hard drop';
      }

      document.addEventListener('keydown', function(e) {
        var overlay = document.getElementById('tetris-overlay');
        if (!overlay || overlay.classList.contains('hidden')) return;
        switch (e.key) {
          case 'ArrowLeft': e.preventDefault(); moveLeft(); break;
          case 'ArrowRight': e.preventDefault(); moveRight(); break;
          case 'ArrowDown': e.preventDefault(); moveDown(); break;
          case 'ArrowUp': e.preventDefault(); rotatePiece(); break;
          case ' ': e.preventDefault(); hardDrop(); break;
        }
      });

      canvas.addEventListener('touchstart', function(e) {
        if (gameOver) return;
        e.preventDefault();
        var t = e.touches[0];
        canvas._tx = t.clientX;
        canvas._ty = t.clientY;
        canvas._tSx = t.clientX;
        canvas._tSy = t.clientY;
        canvas._tTime = Date.now();
      }, { passive: false });

      canvas.addEventListener('touchmove', function(e) {
        if (gameOver) return;
        e.preventDefault();
        var t = e.touches[0];
        var dx = t.clientX - canvas._tx;
        var dy = t.clientY - canvas._ty;
        if (Math.abs(dx) > 30) {
          if (dx > 0) { moveRight(); } else { moveLeft(); }
          canvas._tx = t.clientX;
          canvas._ty = t.clientY;
        }
        if (dy > 30) {
          moveDown();
          canvas._tx = t.clientX;
          canvas._ty = t.clientY;
        }
      }, { passive: false });

      canvas.addEventListener('touchend', function(e) {
        if (gameOver) return;
        e.preventDefault();
        var dx = Math.abs(e.changedTouches[0].clientX - canvas._tSx);
        var dy = Math.abs(e.changedTouches[0].clientY - canvas._tSy);
        var dt = Date.now() - canvas._tTime;
        if (dx < 10 && dy < 10 && dt < 200) {
          rotatePiece();
        }
      });

      // === TETRIS MUSIC ===
      (function() {
        var audio = null, isMuted = true;

        window.toggleMusic = function() {
          if (!audio) {
            audio = new Audio('/audio/tetris-theme.mp3');
            audio.loop = true;
            audio.volume = 0.5;
          }
          isMuted = !isMuted;
          var btn = document.getElementById('music-btn');
          if (isMuted) {
            audio.pause();
            if (btn) btn.innerHTML = '<i class="fa-solid fa-volume-xmark"></i> Music';
          } else {
            audio.play();
            if (btn) btn.innerHTML = '<i class="fa-solid fa-volume-high"></i> Music';
          }
        };

        var origClose = window.closeTetris;
        window.closeTetris = function() {
          if (origClose) origClose();
          if (audio) { audio.pause(); audio.currentTime = 0; }
          isMuted = true;
          var btn = document.getElementById('music-btn');
          if (btn) btn.innerHTML = '<i class="fa-solid fa-volume-xmark"></i> Music';
        };
      })();

      draw();
    })();
  </script>
</body>
</html>
